#!/usr/bin/env python3
"""Refresh scripts/model_prices.json from LiteLLM's canonical price file.

LiteLLM ships an MIT-licensed, daily-updated JSON of per-token prices for
every model across every provider. We vendor a filtered subset (just the
direct Anthropic Claude entries — no Bedrock/Vertex/OpenRouter/Azure regional
mirrors) so `logbook retro estimate-cost` doesn't drift each time Anthropic
reprices a generation.

Run from the repo root: `just refresh-prices`.
"""
from __future__ import annotations

import json
import sys
import urllib.request
from pathlib import Path

SOURCE_URL = "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
OUT_PATH = Path(__file__).resolve().parent / "model_prices.json"

PROVIDER_PREFIXES = ("bedrock/", "vertex_ai/", "openrouter/", "azure/")
REGION_MARKERS = ("@", "global-", "us.", "eu.", "apac.")


def _is_direct_anthropic(key: str) -> bool:
    if not key.startswith("claude-"):
        return False
    k = key.lower()
    if any(p in k for p in PROVIDER_PREFIXES):
        return False
    if any(m in k for m in REGION_MARKERS):
        return False
    return True


def main() -> int:
    with urllib.request.urlopen(SOURCE_URL, timeout=30) as resp:
        data = json.load(resp)
    subset = {k: data[k] for k in sorted(data) if _is_direct_anthropic(k)}
    if not subset:
        sys.exit("refresh-prices: filter matched no entries — LiteLLM schema may have changed")
    OUT_PATH.write_text(json.dumps(subset, indent=2, sort_keys=True) + "\n")
    print(f"wrote {OUT_PATH} ({len(subset)} models)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
